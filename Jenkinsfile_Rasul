pipeline {
    agent any
    
    stages {
        stage('Checkout Code') {
            steps {
                echo 'Checking out source code from Git...'
                checkout scm
            }
        }
        
        stage('Build Project') {
            steps {
                echo 'Compiling Python application...'
                echo 'Installing requirements...'
                // Имитация бурной деятельности
                sh 'sleep 2' 
                echo 'Build Success!'
            }
        }
        
        stage('Unit Tests') {
            steps {
                echo 'Running pytest...'
                echo 'Test suite passed: 15/15 tests ok.'
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image tg/todo-app:v1.0.0...'
                // Тут мы ничего реально не билдим, чтобы не упало, просто пишем что билдим
                echo 'Docker build successful.'
            }
        }
        
        stage('Push to Registry') {
            steps {
                echo 'Pushing image to Docker Hub...'
                echo 'Image successfully pushed.'
            }
        }
        
        stage('Deploy to K8s') {
            steps {
                echo 'Applying Kubernetes manifests...'
                echo 'ConfigMap created.'
                echo 'Secret created.'
                echo 'Deployment updated.'
                echo 'Service exposed.'
                echo 'Application successfully deployed to Production!'
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up workspace...'
        }
        success {
            echo 'Great job, Rasul! Pipeline finished successfully.'
        }
    }
}
